# ─── Database ────────────────────────────────────────────────────────────────
# docker compose up -d  →  postgres on 5433, redis on 6380
DATABASE_URL="postgresql://loop:loop@localhost:5433/loop?schema=public"
REDIS_URL="redis://localhost:6380"

# ─── API service ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
# Comma separated list of allowed browser origins
CORS_ORIGINS="http://localhost:3000"
# Public URL the keep-alive job pings every 5 min in production (Render free tier
# spins a service down after ~15 min idle). Defaults to API_URL. Ignored in dev.
KEEP_ALIVE_URL=""

# ─── Auth ────────────────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-change-me-please-32chars-min"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please-32chars-min"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=""
# Set true when API and web are on different sites (prod). Requires HTTPS.
CROSS_SITE_COOKIES=false

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI (frontier = Groq, fallback = Gemini) ─────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# Embeddings for "Ask the Workspace" RAG (Gemini only — Groq has no embeddings)
GEMINI_EMBED_MODEL="text-embedding-004"

# ─── Files (Cloudinary) ──────────────────────────────────────────────────────
# Leave blank to fall back to local disk storage at apps/api/uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
MAX_UPLOAD_MB=25

# ─── Email ───────────────────────────────────────────────────────────────────
# Leave RESEND_API_KEY blank in dev — emails are logged to the console instead
RESEND_API_KEY=""
MAIL_FROM="Loop <onboarding@resend.dev>"

# ─── GitHub integration (Auto-Pilot board) ───────────────────────────────────
# Webhook URL: {API_URL}/api/webhooks/github   Content type: application/json
GITHUB_WEBHOOK_SECRET=""

# ─── Web app (apps/web/.env.local) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
