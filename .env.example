# ═════════════════════════════════════════════════════════════════════════════
# SUPABASE — the backend (Postgres + Auth + Storage + Realtime)
# ═════════════════════════════════════════════════════════════════════════════
# Dashboard → Project Settings → API. Paste between the quotes.
# `supabase start` prints all three for local development.

# https://<project-ref>.supabase.co   (http://127.0.0.1:54321 locally)
NEXT_PUBLIC_SUPABASE_URL=""

# ── ANON KEY ────────────────────────────────────────────────────────────────
# "anon / public" in the dashboard (or "Publishable key", sb_publishable_…).
# Safe in the browser: it carries no privilege of its own and every request it
# makes is still filtered by row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── SECRET KEY ──────────────────────────────────────────────────────────────
# "service_role" in the dashboard (or "Secret key", sb_secret_…).
#
# WARNING: BYPASSES ROW LEVEL SECURITY COMPLETELY — every row, every workspace.
#   · never prefix with NEXT_PUBLIC_
#   · server only: Edge Functions, route handlers, cron jobs, webhooks
#   · if it leaks, rotate it (Project Settings → API → Rotate)
SUPABASE_SERVICE_ROLE_KEY=""

SUPABASE_PROJECT_REF=""
# Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=""

# Read by supabase/config.toml for local Google sign-in.
# Authorised redirect URI: {NEXT_PUBLIC_SUPABASE_URL}/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_GOOGLE_SECRET=""

# ═════════════════════════════════════════════════════════════════════════════
# WEB APP
# ═════════════════════════════════════════════════════════════════════════════

# Same origin. The API is this app's own route handlers under src/app/api, so
# there is no second host. Only set this to point a local dev server at a
# deployed preview.
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ═════════════════════════════════════════════════════════════════════════════
# AI (optional)
# ═════════════════════════════════════════════════════════════════════════════
# Server-side only — never prefix these with NEXT_PUBLIC_. Without them the AI
# screens report themselves as unconfigured rather than failing at request time.
#
# Groq is tried first, Gemini is the fallback. https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
