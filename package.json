{
  "name": "loop",
  "private": true,
  "version": "1.0.0",
  "description": "Loop — enterprise project management & team collaboration platform (DevFusion 4.0 PS-5). Next.js on Vercel, Supabase for data, auth, storage and realtime.",
  "workspaces": [
    "packages/shared",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @loop/web",
    "build": "npm run build --workspace @loop/web",
    "start": "npm run start --workspace @loop/web",
    "lint": "npm run lint --workspace @loop/web",
    "typecheck": "npm run typecheck --workspace @loop/web",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --linked > apps/web/src/lib/supabase/types.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:seed": "node supabase/seed.mjs",
    "db:seed:reset": "node supabase/seed.mjs --reset"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
