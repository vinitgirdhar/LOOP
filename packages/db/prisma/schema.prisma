// Loop — data model
// Multi-tenant rule: every business table carries workspaceId and every query is scoped by it.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────── enums ───────────────────────────

enum WorkspaceRole {
  OWNER
  PM
  MEMBER
  CLIENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ChannelType {
  CHANNEL
  DM
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  AUTO_APPLIED
}

enum SuggestionKind {
  MOVE_STATUS
  FLAG_BLOCKED
  ASSIGN
  LINK_COMMIT
  SPRINT_PLAN
  ESTIMATE
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  DEADLINE_REMINDER
  MENTION
  FILE_UPLOADED
  COMMENT_ADDED
  SPRINT_STARTED
  SPRINT_ENDED
  SUGGESTION
  INVITE
}

enum MeetingParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
}

enum EmbeddingVisibility {
  INTERNAL // members only — never retrievable by CLIENT
  SHARED   // visible to clients too
}

// ─────────────────────────── identity ───────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?
  avatarUrl       String?
  googleId        String?   @unique
  emailVerifiedAt DateTime?
  isPlatformAdmin Boolean   @default(false)
  isSuspended     Boolean   @default(false)
  twoFactorSecret String?
  twoFactorOn     Boolean   @default(false)
  timezone        String    @default("UTC")
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions           Session[]
  tokens             VerificationToken[]
  memberships        WorkspaceMember[]
  ownedOrganizations Organization[]      @relation("OrgOwner")
  projectMembers     ProjectMember[]
  reportedTasks      Task[]              @relation("TaskReporter")
  assignedTasks      Task[]              @relation("TaskAssignee")
  comments           Comment[]
  attachments        Attachment[]
  messages           Message[]
  reactions          MessageReaction[]
  timeLogs           TimeLog[]
  notifications      Notification[]      @relation("NotifyUser")
  actorNotifications Notification[]      @relation("NotifyActor")
  activity           ActivityLog[]
  auditLogs          AuditLog[]
  wikiPagesCreated   WikiPage[]          @relation("WikiAuthor")
  wikiVersions       WikiVersion[]
  meetingsCreated    Meeting[]
  meetingSeats       MeetingParticipant[]
  channelSeats       ChannelMember[]
  invitesSent        Invite[]
  decidedSuggestions AiSuggestion[]
  askLogs            AskLog[]

  @@index([email])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  otp       String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─────────────────────────── RBAC ───────────────────────────

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "task.update"
  description String
  roles       RolePermission[]
}

model Role {
  id          String           @id @default(cuid())
  key         WorkspaceRole    @unique
  name        String
  description String
  rank        Int // higher = more power, used for "at least" checks
  permissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─────────────────────────── tenancy ───────────────────────────

model BillingPlan {
  id            String         @id @default(cuid())
  key           String         @unique
  name          String
  priceMonthly  Int            @default(0)
  seats         Int            @default(5)
  features      Json           @default("[]")
  organizations Organization[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  planId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User        @relation("OrgOwner", fields: [ownerId], references: [id])
  plan       BillingPlan? @relation(fields: [planId], references: [id])
  workspaces Workspace[]
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String   @unique
  logoUrl        String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  members      WorkspaceMember[]
  departments  Department[]
  projects     Project[]
  invites      Invite[]
  channels     Channel[]
  messages     Message[]
  notifications Notification[]
  activity     ActivityLog[]
  auditLogs    AuditLog[]
  integrations Integration[]
  suggestions  AiSuggestion[]
  health       HealthSnapshot[]
  embeddings   Embedding[]
  settings     Setting[]
  holidays     Holiday[]
  tasks        Task[]
  timeLogs     TimeLog[]
  wikiPages    WikiPage[]
  meetings     Meeting[]
  attachments  Attachment[]
  folders      Folder[]
  labels       Label[]
  comments     Comment[]
  sprints      Sprint[]
  milestones   Milestone[]
  askLogs      AskLog[]

  @@index([organizationId])
}

model Department {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]

  @@unique([workspaceId, name])
}

model WorkspaceMember {
  id           String        @id @default(cuid())
  workspaceId  String
  userId       String
  role         WorkspaceRole @default(MEMBER)
  departmentId String?
  title        String?
  capacityHrs  Int           @default(40) // weekly capacity, used by workload + sprint planning
  joinedAt     DateTime      @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id])

  @@index([workspaceId, email])
}

// ─────────────────────────── projects ───────────────────────────

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  key         String // e.g. "TASK" → TASK-42
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  priority    Priority      @default(MEDIUM)
  startDate   DateTime?
  deadline    DateTime?
  color       String        @default("#6366f1")
  autoApply   Boolean       @default(false) // auto-apply high-confidence AI suggestions
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  members     ProjectMember[]
  columns     BoardColumn[]
  tasks       Task[]
  sprints     Sprint[]
  milestones  Milestone[]
  wikiPages   WikiPage[]
  channels    Channel[]
  folders     Folder[]
  attachments Attachment[]
  timeLogs    TimeLog[]
  labels      Label[]
  meetings    Meeting[]
  activity    ActivityLog[]
  suggestions AiSuggestion[]
  health      HealthSnapshot[]
  embeddings  Embedding[]
  integrations Integration[]

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member") // lead | member | viewer
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model BoardColumn {
  id        String  @id @default(cuid())
  projectId String
  key       String // stable id used by Task.status
  name      String
  order     Int
  isDone    Boolean @default(false)
  wipLimit  Int?
  color     String  @default("#94a3b8")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId, order])
}

model Milestone {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
}

model Sprint {
  id          String       @id @default(cuid())
  workspaceId String
  projectId   String
  name        String
  goal        String?
  status      SprintStatus @default(PLANNED)
  startDate   DateTime
  endDate     DateTime
  capacity    Int          @default(40) // story points
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  points    BurndownPoint[]

  @@index([projectId, status])
}

model BurndownPoint {
  id             String   @id @default(cuid())
  sprintId       String
  date           DateTime
  remainingPts   Int
  completedPts   Int
  remainingTasks Int

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([sprintId, date])
}

// ─────────────────────────── tasks ───────────────────────────

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  number      Int // per-project counter → TASK-42
  title       String
  description String?
  status      String    @default("backlog") // matches BoardColumn.key
  priority    Priority  @default(MEDIUM)
  storyPoints Int?
  estimateHrs Float?
  dueDate     DateTime?
  startDate   DateTime?
  completedAt DateTime?
  order       Float     @default(1000) // position inside its column
  isBlocked   Boolean   @default(false)
  blockedNote String?
  recurrence  String? // none | daily | weekly | monthly
  recurUntil  DateTime?
  assigneeId  String?
  reporterId  String?
  sprintId    String?
  milestoneId String?
  parentId    String? // real subtask of another task
  meetingId   String? // created as a meeting action item
  lastActivityAt DateTime @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter  User?      @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  sprint    Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent    Task?      @relation("TaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Task[]     @relation("TaskTree")
  meeting   Meeting?   @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  subtasks     Subtask[]
  labels       TaskLabel[]
  comments     Comment[]
  attachments  Attachment[]
  timeLogs     TimeLog[]
  activity     ActivityLog[]
  suggestions  AiSuggestion[]
  blocks       TaskDependency[] @relation("Blocker")
  blockedBy    TaskDependency[] @relation("Blocked")

  @@unique([projectId, number])
  @@index([workspaceId])
  @@index([projectId, status])
  @@index([assigneeId])
  @@index([sprintId])
  @@index([dueDate])
}

model Subtask {
  id     String  @id @default(cuid())
  taskId String
  title  String
  done   Boolean @default(false)
  order  Int     @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskDependency {
  id        String @id @default(cuid())
  blockerId String // must finish first
  blockedId String

  blocker Task @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Task @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Label {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  color       String @default("#64748b")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, projectId, name])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model Comment {
  id          String    @id @default(cuid())
  workspaceId String
  taskId      String
  authorId    String
  body        String
  mentions    String[]  @default([])
  editedAt    DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ─────────────────────────── files ───────────────────────────

model Folder {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  parentId    String?
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Folder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]     @relation("FolderTree")
  files     Attachment[]

  @@index([workspaceId, projectId])
}

model Attachment {
  id           String   @id @default(cuid())
  workspaceId  String
  projectId    String?
  taskId       String?
  messageId    String?
  wikiPageId   String?
  folderId     String?
  name         String
  url          String
  publicId     String? // Cloudinary public id (null for local disk)
  mime         String
  size         Int
  version      Int      @default(1)
  replacesId   String?  @unique
  uploadedById String
  createdAt    DateTime @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  message    Message?    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  wikiPage   WikiPage?   @relation(fields: [wikiPageId], references: [id], onDelete: Cascade)
  folder     Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy User        @relation(fields: [uploadedById], references: [id])
  replaces   Attachment? @relation("FileVersions", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy Attachment? @relation("FileVersions")

  @@index([workspaceId, projectId])
  @@index([taskId])
}

// ─────────────────────────── wiki ───────────────────────────

model WikiPage {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  parentId    String?
  title       String
  slug        String
  content     String   @default("")
  isShared    Boolean  @default(false) // visible to CLIENT role
  version     Int      @default(1)
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      WikiPage?     @relation("WikiTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    WikiPage[]    @relation("WikiTree")
  author      User          @relation("WikiAuthor", fields: [authorId], references: [id])
  versions    WikiVersion[]
  attachments Attachment[]

  @@unique([projectId, slug])
  @@index([workspaceId])
}

model WikiVersion {
  id        String   @id @default(cuid())
  pageId    String
  version   Int
  title     String
  content   String
  authorId  String
  createdAt DateTime @default(now())

  page   WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author User     @relation(fields: [authorId], references: [id])

  @@unique([pageId, version])
}

// ─────────────────────────── chat ───────────────────────────

model Channel {
  id          String      @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  topic       String?
  type        ChannelType @default(CHANNEL)
  isPrivate   Boolean     @default(false)
  createdAt   DateTime    @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members   ChannelMember[]
  messages  Message[]

  @@index([workspaceId])
}

model ChannelMember {
  channelId  String
  userId     String
  lastReadAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
}

model Message {
  id          String    @id @default(cuid())
  workspaceId String
  channelId   String
  authorId    String
  body        String
  mentions    String[]  @default([])
  parentId    String? // thread root
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent      Message?          @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Message[]         @relation("Thread")
  reactions   MessageReaction[]
  attachments Attachment[]

  @@index([channelId, createdAt])
}

model MessageReaction {
  id        String @id @default(cuid())
  messageId String
  userId    String
  emoji     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

// ─────────────────────────── meetings / calendar ───────────────────────────

model Meeting {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  title       String
  agenda      String?
  notes       String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  createdById String
  createdAt   DateTime @default(now())

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation(fields: [createdById], references: [id])
  participants MeetingParticipant[]
  actionItems  Task[]

  @@index([workspaceId, startsAt])
}

model MeetingParticipant {
  meetingId String
  userId    String
  status    MeetingParticipantStatus @default(INVITED)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
}

model Holiday {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  date        DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date, name])
}

// ─────────────────────────── time ───────────────────────────

model TimeLog {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  taskId      String?
  userId      String
  seconds     Int       @default(0)
  note        String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  isRunning   Boolean   @default(false)
  day         String // YYYY-MM-DD for cheap daily grouping

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, day])
  @@index([projectId])
}

// ─────────────────────────── activity / audit / notify ───────────────────────────

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  actorId     String?
  type        NotificationType
  title       String
  body        String?
  link        String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("NotifyUser", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotifyActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  taskId      String?
  actorId     String?
  type        String // task.created, task.moved, comment.added, github.push …
  message     String
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorId     String?
  action      String // auth.login, member.role_changed, suggestion.accepted …
  entity      String
  entityId    String?
  meta        Json     @default("{}")
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([action])
}

// ─────────────────────────── integrations & AI ───────────────────────────

model Integration {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  provider    String // github | google_calendar | slack …
  config      Json     @default("{}") // { repo: "org/name" }
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, projectId])
}

model AiSuggestion {
  id             String           @id @default(cuid())
  workspaceId    String
  projectId      String?
  taskId         String?
  kind           SuggestionKind
  title          String
  rationale      String
  evidence       Json             @default("[]") // [{ type, label, url, quote }]
  confidence     Float            @default(0.5)
  proposedChange Json             @default("{}") // { field, from, to }
  status         SuggestionStatus @default(PENDING)
  source         String           @default("rules") // rules | ai
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  decidedBy User?     @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
}

model HealthSnapshot {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  score       Int
  signals     Json     @default("[]") // [{ key, label, value, weight, contribution, detail }]
  actions     Json     @default("[]") // top 3 fixes
  narrative   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Embedding {
  id          String              @id @default(cuid())
  workspaceId String
  projectId   String?
  sourceType  String // task | wiki | message | comment | commit
  sourceId    String
  title       String
  content     String
  url         String?
  visibility  EmbeddingVisibility @default(INTERNAL)
  vector      Unsupported("vector(768)")?
  createdAt   DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([workspaceId, visibility])
}

model AskLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  question    String
  answer      String
  citations   Json     @default("[]")
  model       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ─────────────────────────── settings ───────────────────────────

model Setting {
  id          String  @id @default(cuid())
  workspaceId String?
  scope       String  @default("workspace") // workspace | system
  key         String
  value       Json    @default("{}")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  enabled     Boolean  @default(false)
  rollout     Int      @default(0) // 0-100
  updatedAt   DateTime @updatedAt
}
